{
  "manifest_version": 3,
  "name": "Rocko Global Hotkeys",
  "version": "1.0.0",
  "description": "Global PC shortcuts (Ctrl+Shift+Space) for Rocko Music Player even when minimized",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-play-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "windows": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Play / Pause Rocko Music",
      "global": true
    },
    "next-track": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "windows": "Ctrl+Shift+Right",
        "mac": "Command+Shift+Right"
      },
      "description": "Next Track in Rocko",
      "global": true
    },
    "prev-track": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "windows": "Ctrl+Shift+Left",
        "mac": "Command+Shift+Left"
      },
      "description": "Previous Track in Rocko",
      "global": true
    }
  }
}
